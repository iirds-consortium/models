@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix iirds: <http://iirds.tekom.de/iirds#> .
@prefix schema: <http://schema.org/> .

iirds:Action a rdfs:Class ;
  rdfs:label "Handlung"@de, "action"@en ;
  rdfs:comment "atomic manipulation of an object by a participant"@en ;
  iirds:description "Use the relates-to-action property to create a reference from an information unit to an action."@en ;
  rdfs:subClassOf iirds:FunctionalMetadata .

iirds:AdministrativeMetadata a rdfs:Class ;
  rdfs:label "Verwaltungsmetadaten"@de, "administrative metadata"@en ;
  rdfs:comment "information that allows the management of iiRDS resources"@en ;
  iirds:description "Not intended to be used directly. Use the subclasses instead."@en ;
  rdfs:subClassOf iirds:iirdsDomainEntity .

iirds:AfterUse a rdfs:Class ;
  rdfs:label "Nutzungsende"@de, "after use"@en ;
  rdfs:comment "product life cycle phase that follows the active use of the product"@en ;
  iirds:description "IRI: required"@en, "Not intended to be used directly. Use the subclasses instead. For lifecycle phases not covered by the iiRDS standard subclasses, define custom subclasses."@en ;
  rdfs:subClassOf iirds:ProductLifeCyclePhase .

iirds:ClassificationDomain a rdfs:Class ;
  rdfs:label "Externe Klassifikationsdomäne"@de, "external classification domain"@en ;
  rdfs:comment "domain of an external classification that is assigned to an iiRDS entity"@en ;
  iirds:description "A classification domain relates to a party, meaning a company or organization. The party is the owner or custodian of the domain."@en, "IRI: required"@en ;
  rdfs:subClassOf iirds:AdministrativeMetadata .

iirds:ClassificationType a rdfs:Class ;
  rdfs:label "Klassifikationstyp"@de, "classification type"@en ;
  rdfs:comment "type of an classification that is assigned to an iiRDS domain entity"@en ;
  iirds:description "IRI: required"@en, "The type of classification contained by the domain."@en ;
  rdfs:subClassOf iirds:AdministrativeMetadata .

iirds:Collection a rdfs:Class ;
  rdfs:label "Zusammenstellung"@de, "collection"@en ;
  rdfs:comment "information subject that covers specific content in lists or overviews"@en ;
  iirds:description "IRI: required"@en, "Not intented to be used directly. Use the subclasses instead. For collection subjects not covered by the iiRDS standard subclasses, define custom subclasses."@en ;
  rdfs:subClassOf iirds:InformationSubject .

iirds:Component a rdfs:Class ;
  rdfs:label "Komponente"@de, "component"@en ;
  rdfs:comment "part used as a constituent in an assembled product, system or plant"@en ;
  iirds:description "Components may have relations to other components so that iiRDS Generators can build up a simple component hierarchy with iiRDS structures. The iirds#Component may also be used as a docking point for external component definitions."@en, "IRI: required"@en ;
  rdfs:subClassOf iirds:ProductMetadata .

iirds:Concept a rdfs:Class ;
  rdfs:label "Beschreibung"@de, "concept"@en ;
  rdfs:comment "topic type that provides background information which helps users understand the structure or essential principles of a product, interface, or task"@en ;
  iirds:description """Conceptual information helps users to map their existing knowledge to tasks and other essential information about a product or system.
\t\t"""@en, "IRI: required"@en ;
  rdfs:subClassOf iirds:TopicType .

iirds:Conformity a rdfs:Class ;
  rdfs:label "Konformität"@de, "conformity"@en ;
  rdfs:comment "information subject that covers applicable standards or the fulfilment of a product requirement"@en ;
  iirds:description "IRI: required"@en, "Not intended to be used directly. Use the subclasses instead. For information subjects not covered by the iiRDS standard subclasses, define custom subclasses."@en ;
  rdfs:subClassOf iirds:InformationSubject .

iirds:ContentLifeCycleStatus a rdfs:Class ;
  rdfs:label "Lebenszyklus-Status einer Informationseinheit"@de, "information unit lifecycle status"@en ;
  rdfs:comment "stage of an information unit in the information development process"@en ;
  iirds:description "IRI: optional"@en, "The status value is referenced using has-content-lifecycle-status-value. "@en ;
  rdfs:subClassOf iirds:AdministrativeMetadata .

iirds:ContentLifeCycleStatusValue a rdfs:Class ;
  rdfs:label "Wert des Lebenszyklus-Status einer Informationseinheit"@de, "value of the information unit lifecycle status"@en ;
  rdfs:comment "categorical denomination of the information unit life cycle stage"@en ;
  iirds:description "IRI: required"@en, "The value refers to the content status, for example whether it is approved or withdrawn."@en ;
  rdfs:subClassOf iirds:AdministrativeMetadata .

iirds:DesignAndRealization a rdfs:Class ;
  rdfs:label "Produktentstehung"@de, "design and realization"@en ;
  rdfs:comment "product life cycle phase from environment analysis and ideation through production"@en ;
  iirds:description "IRI: required"@en, "Not intended to be used directly. Use the subclasses instead. For lifecycle phases not covered by the iiRDS standard subclasses, define custom subclasses."@en ;
  rdfs:subClassOf iirds:ProductLifeCyclePhase .

iirds:DirectoryNode a rdfs:Class ;
  rdfs:label "Verzeichnisknoten"@de, "directory node"@en ;
  rdfs:comment "node in a tree-like, ordered collection"@en ;
  iirds:description "A directory is a tree-like, ordered collection of information units. Directory nodes are the entries in the directory. Directories help the user to navigate through the information units. A table of contents is a typical example of a directory. "@en, "Ein Verzeichnis ist eine baumartig organisierte und geordnete Zusammenstellung von Informationseinheiten. Verzeichnisknoten sind die Einträge in dem Baum. Verzeichnisse dienen dem Benutzer als Navigationshilfe über die Informationseinheiten. Ein Inhaltsverzeichnis eines Dokuments ist ein typisches Beispiel eines Verzeichnisses."@de, "IRI: optional"@en ;
  rdfs:subClassOf iirds:iirdsDomainEntity .

iirds:DirectoryNodeType a rdfs:Class ;
  rdfs:label "Verzeichnistyp"@de, "directory node type"@en ;
  rdfs:comment "type of information arranged in a hierarchically ordered list of elements built by a root node and its subordinate nodes"@en ;
  iirds:description "A directory represented by a directory root node and its sub nodes has a type such as 'table of contens' or 'list of figures'."@en, "Ein Verzeichnis, das durch einen Wurzelknoten und seine untergeordneten Knoten aufgespannt wird, hat einen Typ wie 'Inhaltsverzeichnis' oder 'Abbildungsverzeichnis'."@de, "IRI: required"@en ;
  rdfs:subClassOf iirds:InformationType .

iirds:Document a rdfs:Class ;
  rdfs:label "Dokument"@de, "document"@en ;
  rdfs:comment "information unit that consists of an ordered set of information intended by the sender to be regarded as an entity"@en ;
  iirds:description "A document consists of one or more files. It can consist of topics. The resource is either a blank node (when there is no file representing the document) or a file in the iiRDS package."@en, "IRI: required"@en ;
  rdfs:subClassOf iirds:InformationUnit .

iirds:DocumentType a rdfs:Class ;
  rdfs:label "Dokumentart"@de, "document type"@en ;
  rdfs:comment "type of information arranged in a document defined with respect to its specified purpose, function, and form of presentation"@en ;
  iirds:description "Document types define the intended purpose of a document."@en, "IRI: required"@en ;
  rdfs:subClassOf iirds:InformationType .

iirds:DocumentationMetadata a rdfs:Class ;
  rdfs:label "Metadaten der Dokumentation"@de, "documentation metadata"@en ;
  rdfs:comment "information that describes the context to which iiRDS resources apply"@en ;
  iirds:description "Not intended to be used directly. Use the subclasses instead."@en ;
  rdfs:subClassOf iirds:iirdsDomainEntity .

iirds:DownTime a rdfs:Class ;
  rdfs:label "Stillstandzeit"@de, "down time"@en ;
  rdfs:comment "period of time during which an item is not in condition to perform its intended function"@en ;
  iirds:description ""@en, "IRI: optional"@en ;
  rdfs:subClassOf iirds:PlanningTime .

iirds:Event a rdfs:Class ;
  rdfs:label "Ereignis"@de, "event"@en ;
  rdfs:comment "something noticeable that takes place at a given location and point in time"@en ;
  iirds:description """Examples are errors, malfunctions, and warnings.
Use the relates-to-event property to create a reference from an information unit to an event."""@en, "IRI: required"@en ;
  rdfs:subClassOf iirds:FunctionalMetadata .

iirds:ExternalClassification a rdfs:Class ;
  rdfs:label "Externe Klassifikation"@de, "external classification"@en ;
  rdfs:comment "External classification of an iiRDS domain entity. Each classification must be related to the classification domain within which it is unambiguous."@en ;
  iirds:description "External classifications may be assigned to information objects, information units, product variants, product features and components. Typically, external classifications are used to include metadata from other standards. Examples: ECLASS and CDD (IEC 61360) for product classfication and DCC (IEC 61355) or VDI 2770 for document classification."@en, "IRI: optional"@en ;
  rdfs:subClassOf iirds:AdministrativeMetadata .

iirds:Form a rdfs:Class ;
  rdfs:label "Formular"@de, "form"@en ;
  rdfs:comment "topic type that provides information in pre-defined fields"@en ;
  iirds:description "Examples of forms are service reports, field reports, and user feedback."@en, "IRI: required"@en ;
  rdfs:subClassOf iirds:TopicType .

iirds:Formality a rdfs:Class ;
  rdfs:label "Formalität"@de, "formality"@en ;
  rdfs:comment "information subject that covers contractually relevant elements"@en ;
  iirds:description "Examples of formality subjects are license terms and warranty conditions."@en, "IRI: required"@en ;
  rdfs:subClassOf iirds:InformationSubject .

iirds:Fragment a rdfs:Class ;
  rdfs:label "Fragment"@de, "fragment"@en ;
  rdfs:comment "information unit that requires additional context"@en ;
  iirds:description "IRI: required"@en, "Sections, tables, lists, paragraphs, and hazard statements are examples of fragments. Fragments assign metadata to parts of topic or document files in an iiRDS package. The parts are identified by a fragment selector."@en ;
  rdfs:subClassOf iirds:InformationUnit .

iirds:FragmentSelector a rdfs:Class ;
  rdfs:label "Fragmentselektor"@de, "fragment selector"@en ;
  rdfs:comment "selector that defines a part of content by a single identifier"@en ;
  iirds:description "IRI: optional"@en ;
  rdfs:subClassOf iirds:Selector .

iirds:FunctionalMetadata a rdfs:Class ;
  rdfs:label "Funktionale Metadaten"@de, "functional metadata"@en ;
  rdfs:comment "information used to implement advanced content delivery scenarios and content assemblies for specific purposes"@en ;
  iirds:description "Not intended to be used directly. Use the subclasses instead."@en ;
  rdfs:subClassOf iirds:DocumentationMetadata .

iirds:Functionality a rdfs:Class ;
  rdfs:label "Funktionalität"@de, "functionality"@en ;
  rdfs:comment "information subject that covers specific capabilities of the product"@en ;
  iirds:description ""@en, "IRI: required"@en ;
  rdfs:subClassOf iirds:InformationSubject .

iirds:Identity a rdfs:Class ;
  rdfs:label "Identität"@de, "identity"@en ;
  rdfs:comment "complex identifier of a resource in an external system"@en ;
  iirds:description "Complex identifiers may be assigned to information objects, information units, product variants, and components. Typically, identities are used to provide IDs from other systems. Examples: serial numbers for components and module IDs from content management systems for topics."@en, "IRI: optional"@en ;
  rdfs:subClassOf iirds:AdministrativeMetadata .

iirds:IdentityDomain a rdfs:Class ;
  rdfs:label "Identitäts-Domäne"@de, "identity domain"@en ;
  rdfs:comment "organizational origin of an identifier that is assigned to an iiRDS identity"@en ;
  iirds:description "An identity domain relates to a party, meaning a company or organization. The party is the owner or custodian of the domain."@en, "IRI: required"@en ;
  rdfs:subClassOf iirds:AdministrativeMetadata .

iirds:IdentityType a rdfs:Class ;
  rdfs:label "Identitäts-Typ"@de, "identity type"@en ;
  rdfs:comment "distinguished set of identifiers that are assigned to an iiRDS identity"@en ;
  iirds:description "IRI: required"@en, "The type of identity contained by the domain."@en ;
  rdfs:subClassOf iirds:AdministrativeMetadata .

iirds:InformationObject a rdfs:Class ;
  rdfs:label "Informationsobjekt"@de, "information object"@en ;
  rdfs:comment "version- and language-independent abstraction of an information unit"@en ;
  iirds:description "IRI: required"@en, "Only used if a version/language-independent equivalent to an information unit is required. The versioned information unit references the information object."@en ;
  rdfs:subClassOf iirds:iirdsDomainEntity .

iirds:InformationSubject a rdfs:Class ;
  rdfs:label "Informationsthema"@de, "information subject"@en ;
  rdfs:comment "thematical characteristic of content"@en ;
  iirds:description "IRI: required"@en, "Not intented to be used directly. Use the subclasses instead."@en ;
  rdfs:subClassOf iirds:InformationType .

iirds:InformationType a rdfs:Class ;
  rdfs:label "Informationsart"@de, "information type"@en ;
  rdfs:comment "characteristic of content"@en ;
  iirds:description "IRI: required"@en, "Not intented to be used directly."@en ;
  rdfs:subClassOf iirds:iirdsDomainEntity .

iirds:InformationUnit a rdfs:Class ;
  rdfs:label "Informationseinheit"@de, "information unit"@en ;
  rdfs:comment "piece of digitally encoded information"@en ;
  iirds:description "IRI: required"@en, "Not intended to be used directly. Use the subclasses Package, Document, Topic, and Fragment instead."@en ;
  rdfs:subClassOf iirds:iirdsDomainEntity .

iirds:Learning a rdfs:Class ;
  rdfs:label "Lernen"@de, "learning"@en ;
  rdfs:comment "topic type that provides learning content"@en ;
  iirds:description "IRI: required"@en, "Learning content may comprise learning plans, learning objectives, learning content details, summaries, and assessments."@en ;
  rdfs:subClassOf iirds:TopicType .

iirds:MaintenanceInterval a rdfs:Class ;
  rdfs:label "Wartungsintervall"@de, "maintenance interval"@en ;
  rdfs:comment "period of time between scheduled maintenance operations"@en ;
  iirds:description "IRI: optional"@en, "Instances have a maintenance frequency and an optional maintenance duration."@en ;
  rdfs:subClassOf iirds:PlanningTime .

iirds:Package a rdfs:Class ;
  rdfs:label "Paket"@de, "package"@en ;
  rdfs:comment "information unit that bundles other information units for exchange"@en ;
  iirds:description "IRI: required"@en, "There is exactly one Package instance within an iiRDS package. It holds general metadata on the overall iiRDS package."@en ;
  rdfs:subClassOf iirds:InformationUnit .

iirds:Party a rdfs:Class ;
  rdfs:label "Akteur"@de, "party"@en ;
  rdfs:comment "person, organization, or system"@en ;
  iirds:description "Detailed information about a party may be specified in a vCard."@en, "IRI: required"@en ;
  rdfs:subClassOf iirds:AdministrativeMetadata .

iirds:PartyRole a rdfs:Class ;
  rdfs:label "Akteursrolle"@de, "party role"@en ;
  rdfs:comment "responsibility of a person or organization"@en ;
  iirds:description "Examples of party roles: manufacturer, author, inspector."@en, "IRI: required"@en ;
  rdfs:subClassOf iirds:AdministrativeMetadata .

iirds:PlanningTime a rdfs:Class ;
  rdfs:label "Planungszeit"@de, "planning time"@en ;
  rdfs:comment "period of time required for or resulting from a specific task"@en ;
  iirds:description "IRI: optional"@en, "Not intended to be used directly.  Use the subclasses instead."@en ;
  rdfs:subClassOf iirds:FunctionalMetadata .

iirds:Process a rdfs:Class ;
  rdfs:label "Prozess"@de, "process"@en ;
  rdfs:comment "information subject that covers structured activities carried out to achieve a specific goal"@en ;
  iirds:description ""@en, "IRI: required"@en ;
  rdfs:subClassOf iirds:InformationSubject .

iirds:ProductFeature a rdfs:Class ;
  rdfs:label "Produktmerkmal"@de, "product feature"@en ;
  rdfs:comment "product characteristics"@en ;
  iirds:description "IRI: required"@en, "Not intended to be used directly. Use the subclasses instead."@en ;
  rdfs:subClassOf iirds:ProductMetadata .

iirds:ProductFunction a rdfs:Class ;
  rdfs:label "Produktfunktion"@de, "product function"@en ;
  rdfs:comment "capability of a product or a component which is specific or required for the intended product task"@en ;
  iirds:description "Examples: starting a phone call, ending a phone call, ringing."@en, "IRI: required"@en ;
  rdfs:subClassOf iirds:ProductFeature .

iirds:ProductLifeCyclePhase a rdfs:Class ;
  rdfs:label "Produktlebenszyklusphase"@de, "phase of product lifecycle"@en ;
  rdfs:comment "defined period in the evolution of a product from the conceptual idea to its ultimate disposal"@en ;
  iirds:description "IRI: required"@en, "Not intended to be used directly. Use the subclasses instead. "@en ;
  rdfs:subClassOf iirds:ProductMetadata .

iirds:ProductMetadata a rdfs:Class ;
  rdfs:label "Produktmetadaten"@de, "productMetadata"@en ;
  rdfs:comment "information about a product or component"@en ;
  iirds:description "IRI: required"@en, "Not intended to be used directly. Use the subclasses instead."@en ;
  rdfs:subClassOf iirds:DocumentationMetadata .

iirds:ProductProperty a rdfs:Class ;
  rdfs:label "Produkteigenschaft"@de, "product property"@en ;
  rdfs:comment "invariable characteristic of a product whose value is fixed once the product is defined"@en ;
  iirds:description "Examples: dimensions, voltage, power, weight."@en, "IRI: required"@en ;
  rdfs:subClassOf iirds:ProductFeature .

iirds:ProductVariant a rdfs:Class ;
  rdfs:label "Produktvariante"@de, "product variant"@en ;
  rdfs:comment "item or service offered on the market and designed to meet the needs or wishes of customers"@en ;
  iirds:description "Examples: a specific model in a series or an individually manufactured good."@en, "IRI: required"@en ;
  rdfs:subClassOf iirds:ProductMetadata .

iirds:PuttingToUse a rdfs:Class ;
  rdfs:label "In Nutzung nehmen"@de, "putting to use"@en ;
  rdfs:comment "product life cycle phase after production in which a product is set up for its intended use"@en ;
  iirds:description "IRI: required"@en, "Not intended to be used directly. Use the subclasses instead. For lifecycle phases not covered by the iiRDS standard subclasses, define custom subclasses."@en ;
  rdfs:subClassOf iirds:ProductLifeCyclePhase .

iirds:Qualification a rdfs:Class ;
  rdfs:label "Qualifikation"@de, "qualification"@en ;
  rdfs:comment "proficiency, competence, or expertise exhibited by an individual"@en ;
  iirds:description "IRI: required"@en, "Not intended to be used directly. Use the subclasses instead. "@en ;
  rdfs:subClassOf iirds:FunctionalMetadata .

iirds:RangeSelector a rdfs:Class ;
  rdfs:label "Bereichsselektor"@de, "range selector"@en ;
  rdfs:comment "selector that defines the start point and the end point of a part of content"@en ;
  iirds:description ""@en, "IRI: optional"@en ;
  rdfs:subClassOf iirds:Selector .

iirds:Reference a rdfs:Class ;
  rdfs:label "Referenz"@de, "reference"@en ;
  iirds:description """Examples are parameter lists, tables with technical data, UI control overviews, and parts lists.
\t\t"""@de, "IRI: required"@en ;
  rdfs:subClassOf iirds:TopicType .

iirds:Rendition a rdfs:Class ;
  rdfs:label "Inhaltsausprägung"@de, "rendition"@en ;
  rdfs:comment "content of an information unit in a specific format"@en ;
  iirds:description ""@en, "IRI: optional"@en ;
  rdfs:subClassOf iirds:iirdsDomainEntity .

iirds:Role a rdfs:Class ;
  rdfs:label "Rolle"@de, "role"@en ;
  rdfs:comment "set of connected behaviors, privileges, and obligations associated with a party"@en ;
  iirds:description "Describes a set of connected behaviors, privileges and obligations associated with users (humans, software processes or devices) of a system."@en, "IRI: required"@en, "Menge von zusammenhängenden Verhaltensweisen, Berechtigungen und Verpflichtungen, die Nutzern (Menschen, Softwareprozesse oder Geräte) eines Systems zugeordnet sind."@de ;
  rdfs:subClassOf iirds:Qualification .

iirds:Safety a rdfs:Class ;
  rdfs:label "Sicherheit"@de, "safety"@en ;
  rdfs:comment "information subject that covers content which helps to avoid risk"@en ;
  iirds:description "IRI: required"@en, "Not intended to be used directly. Use the subclasses instead."@en ;
  rdfs:subClassOf iirds:InformationSubject .

iirds:Selector a rdfs:Class ;
  rdfs:label "Selektor"@de, "selector"@en ;
  rdfs:comment "pointer to the content of a rendition"@en ;
  iirds:description ""@de, ""@en, "IRI: optional"@en ;
  rdfs:subClassOf iirds:iirdsDomainEntity .

iirds:SkillLevel a rdfs:Class ;
  rdfs:label "Kenntnisstufe"@de, "skill level"@en ;
  rdfs:comment "degree of qualification of an individual"@en ;
  iirds:description "Describe the levels of ability required to carry out a specific task described in the technical documentation."@en, "IRI: required"@en ;
  rdfs:subClassOf iirds:Qualification .

iirds:Supply a rdfs:Class ;
  rdfs:label "Hilfsmittel"@de, "supply"@en ;
  rdfs:comment "physical object used by an actor that performs work tasks described in technical documentation"@en ;
  iirds:description "IRI: required"@en, "Not intended to be used directly. Use the subclasses instead. "@en ;
  rdfs:subClassOf iirds:FunctionalMetadata .

iirds:Task a rdfs:Class ;
  rdfs:label "Aufgabe"@de, "task"@en ;
  rdfs:comment "topic type that provides procedures and action steps to be followed or considered"@en ;
  iirds:description "IRI: required"@en, """Tasks provide instructions and may contain information on other aspects, such as requirements that must be fulfilled or safety instructions.
\t\t"""@en ;
  rdfs:subClassOf iirds:TopicType .

iirds:TechnicalData a rdfs:Class ;
  rdfs:label "Technische Daten"@de, "technical data"@en ;
  rdfs:comment "information subject that covers qualitative and quantitative characteristics of technical objects"@en ;
  iirds:description "IRI: required"@en, "Not intended to be used directly. Use instances of this class instead."@en ;
  rdfs:subClassOf iirds:InformationSubject .

iirds:TechnicalOverview a rdfs:Class ;
  rdfs:label "Technische Übersicht"@de, "technical overview"@en ;
  rdfs:comment "information subject that covers the technical structure of a product"@en ;
  iirds:description "Examples are circuit diagrams, flow diagrams, software interface overviews, and pneumatic diagrams."@en, "IRI: required"@en ;
  rdfs:subClassOf iirds:InformationSubject .

iirds:Topic a rdfs:Class ;
  rdfs:label "Topic"@de, "topic"@en ;
  rdfs:comment "information unit that covers a single subject"@en ;
  iirds:description "IRI: required"@en, "The resource of a topic is a file in the iiRDS package."@en ;
  rdfs:subClassOf iirds:InformationUnit .

iirds:TopicType a rdfs:Class ;
  rdfs:label "Topictyp"@de, "topic type"@en ;
  rdfs:comment "type of information determined according to functional principles"@en ;
  iirds:description "IRI: required"@en, "Possible types include task, learning, and concept. Information units that represent topics may have one or more has-topic-type properties that define the topic's information type. Topics without a has-topic-type property are generic topics, with no specific type."@en ;
  rdfs:subClassOf iirds:InformationType .

iirds:Troubleshooting a rdfs:Class ;
  rdfs:label "Störungsbeseitigung"@de, "troubleshooting "@en ;
  rdfs:comment "topic type that provides an explanation for symptoms, diagnosis, and resolution of problems"@en ;
  iirds:description "IRI: required"@en, "Typical troubleshooting topics contain sections with a description of the system's behavior or symptom, the cause for the error, and a remedy for the error."@en ;
  rdfs:subClassOf iirds:TopicType .

iirds:Use a rdfs:Class ;
  rdfs:label "Nutzung"@de, "use"@en ;
  rdfs:comment "product life cycle phase in which the product is supposed to realize its function"@en ;
  iirds:description "IRI: required"@en, "Not intended to be used directly. Use the subclasses instead. For lifecycle phases not covered by the iiRDS standard subclasses, define custom subclasses."@en ;
  rdfs:subClassOf iirds:ProductLifeCyclePhase .

iirds:WarningMessage a rdfs:Class ;
  rdfs:label "Warnhinweis"@de, "warning message"@en ;
  rdfs:comment "safety-related information that warns about hazards and instructs on how to avoid them"@en ;
  iirds:description "IRI: required"@en, """Warning messages usually consist of a hazard alert symbol, a signal word (such as "Danger", "Warning", "Caution", "Notice"),
a description of the potential hazard, and hints how to avoid the hazard."""@en ;
  rdfs:subClassOf iirds:Safety .

iirds:WorkingTime a rdfs:Class ;
  rdfs:label "Arbeitszeit"@de, "working time"@en ;
  rdfs:comment "period of time that is required for conducting a specific task"@en ;
  iirds:description ""@en, "IRI: optional"@en ;
  rdfs:subClassOf iirds:PlanningTime .

iirds:iirdsDomainEntity a rdfs:Class ;
  rdfs:label "iirdsDomainEntity"@de, "iirdsDomainEntity"@en ;
  rdfs:comment "any resource within the iiRDS domain"@en ;
  iirds:description "Not intended to be used directly. Use the subclasses instead."@en .

iirds:nil a rdfs:Class ;
  rdfs:label "Ende einer Verzeichnisstruktur"@de, "end of Directory node"@en ;
  rdfs:comment "closing element in a chain of directory nodes"@en ;
  iirds:description ""@en ;
  rdfs:subClassOf iirds:DirectoryNode .

iirds:classificationIdentifier a rdf:Property ;
  rdfs:label "Klassifikationsbezeichner"@de, "classification identifier"@en ;
  rdfs:comment "classification identifier of the resource within an external classification domain"@en ;
  iirds:description "Cardinality: http://iirds.tekom.de/iirds#ExternalClassification [1]"@en, "Recommended best practice is to classify the resource by means of a string conforming to a non-IRI identifier in an external classification domain."@en ;
